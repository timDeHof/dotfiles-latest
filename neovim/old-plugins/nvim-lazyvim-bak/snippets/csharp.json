{
  "Console WriteLine": {
    "prefix": "cw",
    "body": ["Console.WriteLine($\"${1:message}\");"],
    "description": "Console.WriteLine with interpolation"
  },
  "Main Method": {
    "prefix": "main",
    "body": [
      "static void Main(string[] args)",
      "{",
      "    ${1:// code}",
      "}"
    ],
    "description": "Main method"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "public class ${1:ClassName}",
      "{",
      "    public ${1:ClassName}()",
      "    {",
      "        ${2:// constructor code}",
      "    }",
      "",
      "    ${3:// properties and methods}",
      "}"
    ],
    "description": "Class template"
  },
  "Async Main": {
    "prefix": "asyncmain",
    "body": [
      "static async Task Main(string[] args)",
      "{",
      "    ${1:// async code}",
      "    await Task.CompletedTask;",
      "}"
    ],
    "description": "Async main method"
  },
  "Try Catch": {
    "prefix": "try",
    "body": [
      "try",
      "{",
      "    ${1:// code}",
      "}",
      "catch (${2:Exception} ex)",
      "{",
      "    Console.WriteLine($\"Error: {ex.Message}\");",
      "}"
    ],
    "description": "Try-catch block"
  },
  "Lambda": {
    "prefix": "lambda",
    "body": ["${1:var} => ${2:result}"],
    "description": "Lambda expression"
  },
  "ForEach": {
    "prefix": "foreach",
    "body": ["foreach (var ${1:item} in ${2:collection})", "{", "    ${3:// code}", "}"],
    "description": "foreach loop"
  },
  "If Statement": {
    "prefix": "if",
    "body": ["if (${1:condition})", "{", "    ${2:// code}", "}"],
    "description": "If statement"
  },
  "If Else": {
    "prefix": "ife",
    "body": ["if (${1:condition})", "{", "    ${2:// code}", "}", "else", "{", "    ${3:// code}", "}"],
    "description": "If-else statement"
  },
  "Property": {
    "prefix": "prop",
    "body": ["public ${1:type} ${2:Name} { get; set; } = ${3:default};"],
    "description": "Auto-property"
  },
  "Logger": {
    "prefix": "logger",
    "body": ["private static readonly ILogger _logger = loggerFactory.CreateLogger<${1:ClassName}>();"],
    "description": "Logger instance"
  },
  "AWS Lambda Function": {
    "prefix": "awslambda",
    "body": [
      "public class ${1:Function}",
      "{",
      "    public APIGatewayProxyResponse FunctionHandler(APIGatewayProxyRequest request, ILambdaContext context)",
      "    {",
      "        return new APIGatewayProxyResponse",
      "        {",
      "            StatusCode = 200,",
      "            Body = \"Hello from Lambda!\"",
      "        };",
      "    }",
      "}"
    ],
    "description": "AWS Lambda function template"
  }
}
