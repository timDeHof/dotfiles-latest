    "glassmorphism",
    "jsonv",
    "Liskov",
    "nominatim",
    "precaching",
    "tanstack",
    "teamforward",
    "vaul",
  ],
  "chat.mcp.gallery.enabled": true,
  "github.copilot.enable": {
