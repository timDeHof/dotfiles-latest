    "kilo-code.new.agentManager.nextTerminal",
  ],
  "kilo-code.new.autocomplete.enableAutoTrigger": true,
  "kilo-code.new.autocomplete.enableChatAutocomplete": true,
  "githubPullRequests.pullRequestDescription": "Copilot",
  "fallow.autoDownload": false,
