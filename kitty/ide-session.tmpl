# Template for the ide function (zsh/functions.zsh), which fills in PROJ and PROJ_NAME
# for each directory. It is not a standalone session. It lives outside kitty/sessions
# because the goto_session picker in kitty.conf lists that folder.
new_tab $PROJ_NAME
enabled_layouts splits,stack
layout splits
cd $PROJ

# Left: editor.
launch --title Editor --var pane=editor nvim .

# Upper right: shell for logs or your development server.
launch --location=vsplit --title logs

# Lower right: shell for tests.
launch --location=hsplit --title tests

# Start with keyboard focus in the editor.
focus_matching_window var:pane=editor
