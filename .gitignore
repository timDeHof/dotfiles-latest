secrets/

# zsh runtime state — plugins/ is re-cloned automatically by zsh/plugins.zsh,
# the rest is per-machine cache zsh regenerates on its own.
zsh/plugins/
zsh/.zsh_sessions/
zsh/.zcompdump*
zsh/.zsh_history

# ...but do pin the default nvim config's plugin versions. Without this the
# lazy-lock.json rule above applies and a fresh machine installs latest-
# everything, which is exactly how a working config drifts into a broken one.
!neovim/nvim/lazy-lock.json
